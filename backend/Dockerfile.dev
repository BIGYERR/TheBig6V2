# syntax=docker/dockerfile:1
# The dev container behind npm run dev (docker-compose.dev.yml builds and runs it). It watches this checkout and
# rebuilds whatever is saved, with nothing running on the Mac (scripts/dev-watch.ts). Built from the repo root, in the
# repo's layout (/srv/backend, /srv/frontends). Only the toolchain is baked in: Node, every dependency of the backend and
# of the frontends workspace (Linux builds, never the Mac's node_modules) and the build configs. The sources are mounted
# read-only from the checkout; backend/dist/, backend/app-web/ and frontends/dist/ are the only folders it writes. A
# change to a package.json, a package-lock.json, angular.json or a tsconfig is baked in by the next npm run dev, which
# rebuilds this image.
# The production image is ./Dockerfile; nothing here touches it.
FROM node:26-bookworm-slim
ENV CI=1 NG_CLI_ANALYTICS=false PORT=3000 IA_BACKEND_KIND=docker IA_DEV_CONTAINER=1
WORKDIR /srv/frontends
COPY frontends/package.json frontends/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontends/angular.json frontends/tsconfig.json ./
WORKDIR /srv/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY backend/tsconfig.server.json ./
# Mount points owned by node: the devices volume, the Angular cache volume and the three build folders. /srv/tests is
# the repo's tests/ in the read-only mount of the repo root, where test/semver-parity.test.ts looks (../../tests from
# test/).
RUN mkdir -p /srv/data dist app-web /srv/frontends/dist /srv/frontends/.angular \
  && chown node:node /srv/data dist app-web /srv/frontends/dist /srv/frontends/.angular && ln -s /repo/tests /srv/tests
USER node
EXPOSE 3000
# Healthy as soon as the server answers, checked every second while it starts.
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --start-interval=1s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/healthz').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "scripts/dev-watch.ts"]
