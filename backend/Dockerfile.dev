# syntax=docker/dockerfile:1
# The dev container behind npm run dev (docker-compose.dev.yml builds and runs it). It watches this checkout and
# rebuilds whatever is saved, with nothing running on the Mac (scripts/dev-watch.ts). Only the toolchain is baked in:
# Node, every dependency (Linux builds, never the Mac's node_modules) and the build configs. The sources are mounted
# read-only from the checkout; dist/ and app-web/ are the only folders it writes. A change to package.json,
# package-lock.json, angular.json or a tsconfig is baked in by the next npm run dev, which rebuilds this image.
# The production image is ./Dockerfile; nothing here touches it.
FROM node:26-bookworm-slim
ENV CI=1 NG_CLI_ANALYTICS=false PORT=3000 IA_BACKEND_KIND=docker IA_DEV_CONTAINER=1
WORKDIR /srv
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY angular.json tsconfig.json tsconfig.server.json ./
# Mount points owned by node: the devices volume, the Angular cache volume and the two build folders. /tests is the
# repo's tests/ in the read-only mount of the repo root, where test/semver-parity.test.ts looks (../../tests from test/).
RUN mkdir -p data dist app-web .angular && chown node:node data dist app-web .angular && ln -s /repo/tests /tests
USER node
EXPOSE 3000
# Healthy as soon as the server answers, checked every second while it starts.
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --start-interval=1s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/healthz').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "scripts/dev-watch.ts"]
