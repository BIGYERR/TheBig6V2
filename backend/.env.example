# Every setting the backend reads. None is required locally; on Heroku, scripts/heroku.sh setup sets the first four.
# Copy to .env and `set -a; . ./.env; set +a` before `npm start`, or let docker compose pass them through.

NODE_ENV=development
# The admin login. Production refuses /admin until both are set. Left empty locally, they default to admin / asylum,
# a login everyone can read in this public repo: production's password is a long random one, set only as a Heroku
# config var (scripts/heroku.sh setup asks for it), never written here.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Browser origins allowed to call /api, comma separated; * matches anything but a slash.
CORS_ORIGINS=https://bigyerr.github.io,app://localhost,http://localhost:*,http://127.0.0.1:*

PORT=3000
# How often the app beats, and how long after its last beat a device still counts as connected.
BEAT_MS=15000
CONNECTED_WINDOW_MS=45000
# Devices kept before the least recently seen are dropped.
MAX_DEVICES=5000
# A JSON file that keeps devices across restarts. Leave empty on Heroku: its disk resets on every restart.
DATA_FILE=
# 1 serves the connection dot demo at /client/. Defaults to on, except in production.
CLIENT_DEMO=
# 0 stops the one stdout line per request ("request POST /api/heartbeat 200 3 ms <ip> iPhone"). Defaults to on.
LOG_REQUESTS=
# Trust X-Forwarded-For / -Proto from one proxy, and redirect http to https. Auto: on when DYNO is set (Heroku).
TRUST_PROXY=
