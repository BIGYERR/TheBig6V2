{
  "name": "iron-asylum-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Iron Asylum backend: the website, the device heartbeat API and the admin vision dashboard.",
  "type": "module",
  "main": "dist/server/server.js",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/server/server.js",
    "dev": "node ../tools/run.mjs server-backend-dev -- node scripts/dev.ts",
    "dev:down": "node ../tools/run.mjs backend-dev-down -- docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:server": "node ../tools/run.mjs server-backend-dev-server -- node --watch server/server.ts",
    "build": "node scripts/app-bundle.ts && npm run build:server && npm run build:ui",
    "build:server": "node -e \"require('node:fs').rmSync('dist/server', { recursive: true, force: true })\" && tsc -p tsconfig.server.json",
    "build:ui": "ng build admin && ng build site",
    "app:bundle": "node scripts/app-bundle.ts",
    "admin:dev": "node ../tools/run.mjs server-backend-admin -- ng serve admin",
    "site:dev": "node ../tools/run.mjs server-backend-site -- ng serve site",
    "pretest": "npm run typecheck",
    "test": "node ../tools/run.mjs backend-test -- node --test --test-reporter=spec test/",
    "typecheck": "node ../tools/run.mjs backend-typecheck -- sh -c 'tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json'",
    "predocker:up": "node scripts/app-bundle.ts",
    "docker:up": "node ../tools/run.mjs backend-docker-up -- docker compose up --build -d --wait",
    "docker:down": "node ../tools/run.mjs backend-docker-down -- docker compose down",
    "docker:logs": "node ../tools/run.mjs server-backend-docker -- docker compose logs -f --timestamps api",
    "mac-local-backend": "node ../tools/run.mjs backend-mac-local --sub -- bash scripts/mac-local-backend.sh",
    "mac-local-backend:down": "node ../tools/run.mjs backend-mac-local-down -- bash scripts/mac-local-backend.sh down",
    "mac-local-backend:status": "node ../tools/run.mjs backend-mac-local-status -- bash scripts/mac-local-backend.sh status",
    "mac-local-backend:logs": "node ../tools/run.mjs server-backend-mac-local -- bash scripts/mac-local-backend.sh logs",
    "heroku": "node ../tools/run.mjs heroku --sub -- bash scripts/heroku.sh",
    "lint": "node ../tools/run.mjs backend-lint -- eslint .",
    "logs": "node ../tools/logs.mjs"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
