 //   end()              no activity
 // Fire-and-forget: no callbacks, and any error is swallowed so the stopwatch never breaks on the bridge.
 // Native applies the calls in arrival order, so the last one wins.
+//
+// hasIsland (D234 R1): true only when native confirms this phone has a Dynamic Island. It is settled before
+// deviceready, once, and never changes after; the page reads it once at the timer's init. Unknown reads false.
 
+var channel = require('cordova/channel');
+
+// The pattern cordova-plugin-device uses: deviceready waits for this sticky channel.
+channel.createSticky('onIAIslandReady');
+channel.waitForInitialization('onIAIslandReady');
+
+// A missing or silent native side must never hold deviceready: past this, the answer is "no island".
+var INFO_TIMEOUT_MS = 1000;
+
 function send(action, args) {
