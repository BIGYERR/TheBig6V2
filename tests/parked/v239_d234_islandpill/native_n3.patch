+
+channel.onCordovaReady.subscribe(function () {
+    var settled = false;
+    function settle(hasIsland) {
+        if (settled) return;
+        settled = true;
+        island.hasIsland = hasIsland;
+        channel.onIAIslandReady.fire();
+    }
+    setTimeout(function () { settle(false); }, INFO_TIMEOUT_MS);
+    try {
+        cordova.exec(function (info) {
+            settle(!!(info && info.hasIsland));
+        }, function () {
+            settle(false);
+        }, 'IAIsland', 'info', []);
+    } catch (e) {
+        settle(false);
+    }
+});
+
+module.exports = island;
