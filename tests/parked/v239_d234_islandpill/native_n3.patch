+    /// D234 R1: whether this phone has a Dynamic Island, read once by island.js before deviceready.
+    /// It touches no activity, so it answers at once rather than through the work chain.
+    @objc(info:)
+    func info(_ command: CDVInvokedUrlCommand) {
+        let model = IAIsland.modelIdentifier()
+        let result = CDVPluginResult(status: .ok, messageAs: [
+            "hasIsland": IAIsland.islandModels.contains(model),
+            "model": model,
+        ])
+        commandDelegate.send(result, callbackId: command.callbackId)
+    }
+
+    /// The phones with a Dynamic Island, by model identifier. A fixed list, so an unknown model (a phone newer than
+    /// this list) reads false and keeps the edge tab. The identifiers match Xcode 26.6's simulator device profiles
+    /// (/Library/Developer/CoreSimulator/Profiles/DeviceTypes/<name>.simdevicetype/Contents/Resources/profile.plist,
+    /// modelIdentifier). Left out: iPhone17,5 (16e, a notch) and iPhone18,5 (17e: no profile field shows an island).
+    private static let islandModels: Set<String> = [
+        "iPhone15,2", "iPhone15,3",                              // 14 Pro, 14 Pro Max
+        "iPhone15,4", "iPhone15,5",                              // 15, 15 Plus
+        "iPhone16,1", "iPhone16,2",                              // 15 Pro, 15 Pro Max
+        "iPhone17,1", "iPhone17,2", "iPhone17,3", "iPhone17,4",  // 16 Pro, 16 Pro Max, 16, 16 Plus
+        "iPhone18,1", "iPhone18,2", "iPhone18,3", "iPhone18,4",  // 17 Pro, 17 Pro Max, 17, Air
+    ]
+
+    /// The model identifier: utsname.machine on a device; in the simulator, the simulated model.
+    private static func modelIdentifier() -> String {
+        #if targetEnvironment(simulator)
+        return ProcessInfo.processInfo.environment["SIMULATOR_MODEL_IDENTIFIER"] ?? ""
+        #else
+        var system = utsname()
+        uname(&system)
+        return withUnsafeBytes(of: &system.machine) { bytes in
+            String(decoding: bytes.prefix(while: { $0 != 0 }), as: UTF8.self)
+        }
+        #endif
+    }
+
