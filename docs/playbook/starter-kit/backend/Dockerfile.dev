# syntax=docker/dockerfile:1
# The dev container behind npm run dev (docker-compose.dev.yml builds and runs it). Only the toolchain is baked in: Node
# and every dependency (Linux builds, never the Mac's node_modules) and the build configs. The sources are mounted
# read-only from the checkout, and node --watch restarts the server on every save, with nothing running on the Mac. A
# change to package.json, package-lock.json or a tsconfig is baked in by the next npm run dev, which rebuilds this image.
# The production image is ./Dockerfile; nothing here touches it.
FROM node:26-bookworm-slim
ENV CI=1 PORT=3000 BACKEND_KIND=docker
WORKDIR /srv/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY backend/tsconfig.server.json backend/tsconfig.test.json ./
# Mount points for the read-only sources.
RUN mkdir -p server test
USER node
EXPOSE 3000
# Healthy as soon as the server answers, checked every second while it starts.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --start-interval=1s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/healthz').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "--watch", "--enable-source-maps", "server/server.ts"]
