{
  "name": "iron-asylum",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync": "node scripts/sync-legacy.mjs",
    "sync:check": "node scripts/sync-legacy.mjs --check",
    "prestart": "npm run sync",
    "start": "ng serve",
    "prebuild": "npm run sync",
    "build": "ng build",
    "e2e": "node e2e/run-e2e.mjs",
    "ios:sim": "node scripts/ios.mjs sim",
    "ios:device": "node scripts/ios.mjs device",
    "ios:open": "node scripts/ios.mjs open",
    "lint": "ng lint",
    "prelint": "npm run sync",
    "lint:legacy": "npm run sync && eslint -c eslint.legacy.config.mjs --format ./scripts/eslint-summary.mjs public/legacy/app.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "cordova": "^13.0.0",
    "cordova-ios": "^8.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "puppeteer": "^25.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0"
  },
  "description": "Iron Asylum as an Angular app, packaged for iOS with Cordova. Generated from the repo root index.html.",
  "allowScripts": {
    "puppeteer@25.13.0": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  },
  "cordova": {
    "platforms": [
      "ios"
    ]
  }
}
