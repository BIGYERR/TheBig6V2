<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova project for the iOS app. The web content is the Angular build in www/ (npm run build).
  version and ios-CFBundleVersion follow the root index.html's ia-version; scripts/ios.mjs keeps them in step,
  so a phone shows which build it carries. Both are the canonical M.m.p (ia-version 239 = 0.239.0, 0.239.1 = 0.239.1).
-->
<widget id="com.bigyerr.ironasylum" version="0.253.1" ios-CFBundleVersion="0.253.1"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>The Asylum</name>
  <description>Hybrid strength and running programs.</description>
  <author href="https://bigyerr.github.io/TheBig6V2/">Mario Canas</author>
  <content src="index.html" />

  <!-- The only hosts the app talks to: the bug report form and the web font. -->
  <access origin="https://api.web3forms.com" />
  <access origin="https://fonts.googleapis.com" />
  <access origin="https://fonts.gstatic.com" />
  <allow-intent href="https://*/*" />
  <allow-intent href="mailto:*" />

  <platform name="ios">
    <!-- Serve www/ from app://localhost; the Angular Platform service keys Cordova detection on this scheme. -->
    <preference name="scheme" value="app" />
    <preference name="hostname" value="localhost" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="Orientation" value="portrait" />
    <!-- iPhone only: the app is portrait only, and App Store Connect refuses an iPad-capable bundle that does not list
         all four orientations (it refused 0.252.0). Cordova writes TARGETED_DEVICE_FAMILY "1" from this. -->
    <preference name="target-device" value="handset" />
    <preference name="BackgroundColor" value="#F4F1E8" />
    <!-- Generated by npm run sync from the root apple-touch-icon.png (1024x1024, no alpha). -->
    <icon src="public/apple-touch-icon.png" width="1024" height="1024" />
    <!-- Export compliance: the app's only encryption is the HTTPS iOS itself provides (the web view's fetches), which
         is exempt, so App Store Connect never holds a TestFlight build on the encryption question. -->
    <config-file target="*-Info.plist" parent="ITSAppUsesNonExemptEncryption">
      <false />
    </config-file>
  </platform>
</widget>
