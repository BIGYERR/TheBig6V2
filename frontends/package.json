{
  "name": "iron-asylum-frontends",
  "version": "0.0.0",
  "private": true,
  "description": "The website and the admin dashboard (Angular), and what the frontends share (common/). The backend serves their builds from dist/. The app (app/) stays its own package for now: Cordova keeps its platforms and plugins in its project root.",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "ng build website && ng build admin",
    "website:dev": "node ../tools/run.mjs server-website -- ng serve website",
    "admin:dev": "node ../tools/run.mjs server-admin -- ng serve admin",
    "typecheck": "node ../tools/run.mjs frontends-typecheck -- tsc -p tsconfig.json --noEmit",
    "lint": "node ../tools/run.mjs frontends-lint -- eslint .",
    "logs": "node ../tools/logs.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
